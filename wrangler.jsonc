{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-tam-com",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  }
}
